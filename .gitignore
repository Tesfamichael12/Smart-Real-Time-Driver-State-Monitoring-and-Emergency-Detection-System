dist/
build/
out/
coverage/
.nyc_output/
.vite/
.parcel-cache/
.turbo/
.next/
.cache/
.eslintcache

# Python artifacts
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
.venv/
pip-wheel-metadata/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local env files
.env
.env.local
.env.*.local

# Logs and runtime files
*.log
*.out
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project-generated artifacts
logs/
models/
checkpoints/
outputs/
results/
runs/
data/
*.mp4
*.avi
*.mov
*.mkv

